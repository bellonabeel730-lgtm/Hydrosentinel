@page
@using HydroSentinel.Services
@inject IDemoMode DemoMode
@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Dashboard";
    var data = DemoMode.Snapshot;
    var primaryDevice = data.Devices.FirstOrDefault();
    var online = data.Devices.Count(x => x.Status.Equals("Online", StringComparison.OrdinalIgnoreCase));
    var openAlerts = data.Alerts.Count(x => x.Status.Equals("Open", StringComparison.OrdinalIgnoreCase));
}
@section Styles { <link rel="stylesheet" href="~/css/customer-dashboard.css" asp-append-version="true" /> }
<div class="dashboard-page">
    @if (!DemoMode.Enabled)
    {
        <section class="dashboard-intro" aria-labelledby="dashboard-title"><div><p class="customer-eyebrow">Customer portal</p><h2 id="dashboard-title">Demo mode is unavailable.</h2><p class="customer-lede">Run this application in the ASP.NET Core Development environment to use the fictional customer experience.</p></div></section>
    }
    else
    {
        <section class="dashboard-intro dashboard-intro-premium" aria-labelledby="dashboard-title"><div class="dashboard-intro-copy"><div class="dashboard-kicker"><span class="dashboard-kicker-mark" aria-hidden="true"></span> DEMONSTRATION ACCOUNT <span aria-hidden="true">/</span> CUSTOMER OVERVIEW</div><h2 id="dashboard-title">Your water system, at a glance.</h2><p class="customer-lede">Welcome, @data.Profile.FullName. Monitor your fictional HydroSentinel account from one calm operational view.</p></div><div class="dashboard-intro-actions"><span class="customer-status-badge dashboard-connection-status"><span aria-hidden="true"></span> Demo services online</span><a class="customer-button customer-button-primary" asp-page="/Customer/Devices/Add">Add demo device <span aria-hidden="true">&rarr;</span></a></div></section>
        <section class="dashboard-metrics" aria-label="Demo account summary"><a class="dashboard-metric" asp-page="/Customer/Devices/Index"><span class="dashboard-icon dashboard-icon-blue" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 7h6M9 17h6"/></svg></span><span><small>Registered devices</small><strong>@data.Devices.Count</strong><em>Temporary demo records</em></span><span class="dashboard-arrow" aria-hidden="true">&rarr;</span></a><a class="dashboard-metric" asp-page="/Customer/Devices/Index"><span class="dashboard-icon dashboard-icon-green" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 12a8 8 0 0 1 14-5M20 12a8 8 0 0 1-14 5"/><path d="M18 4v4h-4M6 20v-4h4"/></svg></span><span><small>Online now</small><strong>@online</strong><em>Simulated connectivity</em></span><span class="dashboard-arrow" aria-hidden="true">&rarr;</span></a><a class="dashboard-metric" asp-page="/Customer/Subscription/Index"><span class="dashboard-icon dashboard-icon-purple" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18M7 15h3"/></svg></span><span><small>Subscription</small><strong>@data.Subscription.PlanName</strong><em>Demonstration only</em></span><span class="dashboard-arrow" aria-hidden="true">&rarr;</span></a><a class="dashboard-metric dashboard-metric-attention" asp-page="/Customer/Alerts/Index"><span class="dashboard-icon dashboard-icon-orange" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m12 3 9 17H3L12 3Z"/><path d="M12 9v4M12 17h.01"/></svg></span><span><small>Open alerts</small><strong>@openAlerts</strong><em>Simulated incidents</em></span><span class="dashboard-arrow" aria-hidden="true">&rarr;</span></a></section>
        <section class="dashboard-pulse dashboard-panel" aria-labelledby="system-pulse-title"><div class="dashboard-pulse-heading"><div><p class="customer-eyebrow">System pulse <span class="eyebrow-dot" aria-hidden="true"></span> illustrative telemetry</p><h3 id="system-pulse-title">Operational overview</h3></div><a class="dashboard-text-link" asp-page="/Customer/Monitoring">Open monitoring <span aria-hidden="true">&rarr;</span></a></div>@if (primaryDevice is null) { <div class="dashboard-pulse-empty"><span class="dashboard-empty-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 7h6M9 17h6"/></svg></span><div><strong>No demo devices registered</strong><p>Add a fictional device to explore the system pulse view. No hardware ownership or connectivity is implied.</p><a class="customer-button customer-button-secondary" asp-page="/Customer/Devices/Add">Add demo device</a></div></div> } else { <div class="dashboard-pulse-body"><div class="dashboard-pulse-device"><div class="dashboard-device-heading"><span class="dashboard-device-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 4h10v16H7z"/><path d="M9 7h6M9 17h6"/></svg></span><div><span class="dashboard-label">Selected device</span><h4>@primaryDevice.Name</h4><p>@primaryDevice.Model <span aria-hidden="true">·</span> @primaryDevice.Serial</p></div><span class="device-live-status"><span aria-hidden="true"></span>@primaryDevice.Status</span></div><div class="dashboard-level-visual"><div class="dashboard-level-top"><span>Water level</span><strong>@primaryDevice.WaterLevel%</strong></div><div class="dashboard-level-track" role="img" aria-label="Illustrative demo water level @primaryDevice.WaterLevel percent"><span style="width:@primaryDevice.WaterLevel%"></span><i aria-hidden="true"></i></div><div class="dashboard-level-meta"><span>Last seen @primaryDevice.LastSeen.LocalDateTime.ToString("g")</span><span>Illustrative demo telemetry</span></div></div><a class="customer-button customer-button-secondary" asp-page="/Customer/Devices/Details" asp-route-id="@primaryDevice.Id">View device details <span aria-hidden="true">&rarr;</span></a></div><div class="dashboard-pulse-readings" aria-label="Illustrative device readings"><div><span class="reading-icon reading-icon-blue" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3c3 4 6 7 6 11a6 6 0 0 1-12 0c0-4 3-7 6-11Z"/></svg></span><span><small>Pressure</small><strong>@primaryDevice.Pressure.ToString("0.0") <em>bar</em></strong></span></div><div><span class="reading-icon reading-icon-green" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3v18M5 8h14M7 8v8M17 8v8"/></svg></span><span><small>Pump status</small><strong>@primaryDevice.PumpStatus</strong></span></div><div><span class="reading-icon reading-icon-navy" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 18V6M4 18h16"/><path d="m7 14 3-4 3 2 4-6"/></svg></span><span><small>Signal strength</small><strong>@primaryDevice.Signal</strong></span></div><div><span class="reading-icon reading-icon-amber" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="7" width="17" height="10" rx="2"/><path d="M21 10v4M6 10v4"/></svg></span><span><small>Battery</small><strong>@primaryDevice.Battery</strong></span></div></div></div> }<div class="dashboard-data-strip"><span><span class="data-strip-dot" aria-hidden="true"></span> DEMONSTRATION ONLY</span><span>Generated by Development Demo Mode. Not connected hardware data.</span></div></section>
        <section class="dashboard-content-grid" aria-label="Account activity"><article class="dashboard-panel dashboard-alerts-rail"><div class="dashboard-panel-heading"><div><p class="customer-eyebrow">Attention</p><h3>Recent alerts</h3></div><a class="dashboard-text-link" asp-page="/Customer/Alerts/Index">View all <span aria-hidden="true">&rarr;</span></a></div><div class="dashboard-alert-list">@foreach (var alert in data.Alerts.Take(2)) { <a class="dashboard-alert-row" asp-page="/Customer/Alerts/Details" asp-route-id="@alert.Id"><span class="alert-severity alert-severity-@alert.Severity.ToLowerInvariant()" aria-hidden="true"></span><span><strong>@alert.Title</strong><small>@alert.Description</small></span><time datetime="@alert.Occurred.ToString("O")">@alert.Occurred.LocalDateTime.ToString("g")</time><span class="dashboard-row-arrow" aria-hidden="true">&rarr;</span></a> }</div></article><article class="dashboard-panel dashboard-subscription-rail"><div class="dashboard-panel-heading"><div><p class="customer-eyebrow">Account <span aria-hidden="true">·</span> demo data</p><h3>Current plan</h3></div><a class="dashboard-text-link" asp-page="/Customer/Subscription">Manage <span aria-hidden="true">&rarr;</span></a></div><div class="dashboard-plan-summary"><span class="plan-orbit" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6 5.6 18.4"/></svg></span><div><strong>@data.Subscription.PlanName</strong><p>@data.Subscription.CoveredDevices demo devices covered</p><span class="dashboard-data-note">@data.Subscription.Label</span></div></div><a class="customer-button customer-button-secondary" asp-page="/Customer/Subscription/Plans">Compare plans</a></article></section>
        <section class="dashboard-actions-section" aria-labelledby="explore-title"><div class="dashboard-section-heading"><div><p class="customer-eyebrow">Next steps</p><h3 id="explore-title">Explore your demo workspace</h3></div><p>Shortcuts for the most useful customer actions.</p></div><div class="dashboard-quick-actions"><a asp-page="/Customer/Devices/Index"><span class="quick-action-index">01</span><span>View devices</span><span aria-hidden="true">&rarr;</span></a><a asp-page="/Customer/Monitoring"><span class="quick-action-index">02</span><span>Open monitoring</span><span aria-hidden="true">&rarr;</span></a><a asp-page="/Customer/Alerts"><span class="quick-action-index">03</span><span>Review alerts</span><span aria-hidden="true">&rarr;</span></a><a asp-page="/Customer/Notifications"><span class="quick-action-index">04</span><span>Notifications</span><span aria-hidden="true">&rarr;</span></a><a asp-page="/Customer/Support/Index"><span class="quick-action-index">05</span><span>Contact support</span><span aria-hidden="true">&rarr;</span></a></div></section>
    }
</div>
