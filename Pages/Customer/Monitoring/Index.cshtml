@page
@model HydroSentinel.Pages.Customer.Monitoring.IndexModel
@{ Layout = "_CustomerLayout"; ViewData["Title"] = "Monitoring"; var device = Model.SelectedDevice; }
@section Styles { <link rel="stylesheet" href="~/css/customer-monitoring-alerts.css" asp-append-version="true" /> }
<div class="monitoring-page"><section class="monitoring-intro"><div><p class="customer-eyebrow">ILLUSTRATIVE TELEMETRY · DEMO MODE</p><h2>Monitoring that makes system behaviour clear.</h2><p class="customer-lede">All readings below are generated sample data. They are not live hardware measurements.</p></div><span class="customer-status-badge"><span></span>Demonstration only</span></section><form method="get" class="monitoring-toolbar"><label for="monitor-device">Device</label><select id="monitor-device" name="DeviceId">@foreach (var item in Model.Data.Devices) { <option value="@item.Id" selected="@(item.Id == device?.Id)">@item.Name</option> }</select><label for="monitor-range">Range</label><select id="monitor-range" name="Range"><option value="24h" selected="@(Model.Range == "24h")">Last 24 hours</option><option value="7d" selected="@(Model.Range == "7d")">Last 7 days</option></select><button class="customer-button customer-button-secondary" type="submit">Refresh demo data</button></form><section class="monitoring-state-banner"><div><p class="customer-eyebrow">DEMO DEVICE · @device?.Name</p><h3>Illustrative readings are available</h3><p>Timestamped values below are generated for interface testing and are clearly labelled as non-production data.</p></div></section><div class="monitoring-metrics"><article class="monitoring-metric customer-panel"><strong>Water level</strong><b>@device?.WaterLevel%</b><small>Illustrative percentage</small></article><article class="monitoring-metric customer-panel"><strong>Pressure</strong><b>@device?.Pressure.ToString("0.0") bar</b><small>Illustrative pressure</small></article><article class="monitoring-metric customer-panel"><strong>Pump status</strong><b>@device?.PumpStatus</b><small>Simulated state</small></article><article class="monitoring-metric customer-panel"><strong>Signal / battery</strong><b>@device?.Signal · @device?.Battery</b><small>Simulated connectivity</small></article></div><article class="customer-panel monitoring-readings-panel"><div class="monitoring-panel-heading"><div><p class="customer-eyebrow">Historical readings</p><h3>Recent demo samples</h3></div></div><div class="comparison-table-wrap"><table class="comparison-table"><thead><tr><th>Timestamp</th><th>Water level</th><th>Pressure</th><th>Pump state</th></tr></thead><tbody>@foreach (var reading in Model.Data.Readings) { <tr><td>@reading.Timestamp.LocalDateTime.ToString("g")</td><td>@reading.WaterLevel%</td><td>@reading.Pressure.ToString("0.0") bar</td><td>@reading.PumpStatus</td></tr> }</tbody></table></div></article><section class="monitoring-footer-row"><a class="customer-button customer-button-secondary" asp-page="/Customer/Devices/Details" asp-route-id="@device?.Id">Back to device</a><a class="customer-button customer-button-secondary" asp-page="/Customer/Alerts">View alerts</a></section></div>
