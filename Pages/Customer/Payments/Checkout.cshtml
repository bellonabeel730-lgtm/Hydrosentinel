@page
@model HydroSentinel.Pages.Customer.Payments.CheckoutModel
@{ Layout = "_CustomerLayout"; ViewData["Title"] = "Checkout"; }
@section Styles { <link rel="stylesheet" href="~/css/customer-subscriptions-payments.css" asp-append-version="true" /> }
<section class="billing-page"><div class="billing-intro"><div><p class="customer-eyebrow">DEMO CHECKOUT</p><h2>Review your order</h2><p class="customer-lede">Choose a simulated outcome to test the payment-result experience. No payment provider is contacted.</p></div><span class="billing-state billing-state-warning"><i></i>Demonstration only</span></div>@if (Model.SelectedPlan is null) { <article class="billing-panel"><h3>Choose a valid demo plan</h3><a class="customer-button customer-button-secondary" asp-page="/Customer/Subscription/Plans">Back to plans</a></article> } else { <div class="billing-grid checkout-grid"><article class="billing-panel checkout-summary"><div class="billing-panel-heading"><div><p class="billing-kicker">Order summary · demo</p><h3>@Model.SelectedPlan.Name plan</h3></div></div><dl class="billing-detail-list"><div><dt>One-time setup</dt><dd>₦@Model.SelectedPlan.HardwarePrice.ToString("N0")</dd></div><div><dt>Monthly subscription</dt><dd>₦@Model.SelectedPlan.MonthlyPrice.ToString("N0")</dd></div><div><dt>Device allowance</dt><dd>@Model.SelectedPlan.DeviceAllowance</dd></div><div class="billing-total"><dt>Label</dt><dd>DEMO ONLY</dd></div></dl></article><article class="billing-panel checkout-payment"><p class="billing-kicker">Simulated payment outcome</p><h3>No credentials required</h3><form method="post" class="billing-form"><input type="hidden" name="Plan" value="@Model.Plan" /><label for="outcome">Choose result</label><select id="outcome" name="Outcome"><option value="success">Confirmed (demo)</option><option value="pending">Pending (demo)</option><option value="failed">Failed (demo)</option><option value="cancelled">Cancelled (demo)</option></select><button class="customer-button customer-button-primary" type="submit">Run simulated checkout</button><p class="billing-help">No Paystack request, card data, subscription activation, or real charge occurs.</p></form></article></div> }<div class="billing-action-footer"><a class="customer-button customer-button-secondary" asp-page="/Customer/Subscription/Plans">Back to plans</a></div></section>
