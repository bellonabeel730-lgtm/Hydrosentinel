@page
@using HydroSentinel.Services
@inject IDemoMode DemoMode
@{ Layout = "_CustomerLayout"; ViewData["Title"] = "Payment History"; }
@section Styles { <link rel="stylesheet" href="~/css/customer-subscriptions-payments.css" asp-append-version="true" /> }
<section class="billing-page"><div class="billing-intro"><div><p class="customer-eyebrow">DEMO BILLING RECORDS</p><h2>Payment history</h2><p class="customer-lede">Fictional payment outcomes generated by the demo checkout.</p></div><span class="billing-state billing-state-warning"><i></i>Demonstration only</span></div><div class="history-table billing-panel"><div class="customer-section-heading"><div><p class="billing-kicker">Temporary records</p><h3>Transactions</h3></div><a class="billing-text-link" asp-page="/Customer/Subscription">Subscription &rarr;</a></div><div class="comparison-table-wrap"><table class="comparison-table"><thead><tr><th>Reference</th><th>Date</th><th>Plan</th><th>Amount</th><th>Status</th><th>Label</th></tr></thead><tbody>@foreach (var payment in DemoMode.Snapshot.Payments) { <tr><td>@payment.Reference</td><td>@payment.Date.LocalDateTime.ToString("g")</td><td>@payment.Plan</td><td>₦@payment.Amount.ToString("N0")</td><td>@payment.Status</td><td>@payment.Label</td></tr> }</tbody></table></div></div></section>
