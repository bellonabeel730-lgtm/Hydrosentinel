@page
@model HydroSentinel.Pages.Customer.Settings.NotificationPreferencesModel
@{ Layout = "_CustomerLayout"; ViewData["Title"] = "Notification Preferences"; }
@section Styles { <link rel="stylesheet" href="~/css/customer-account-support.css" asp-append-version="true" /> }
<section class="stage7-intro"><div><p class="customer-eyebrow">Account settings</p><h2>Choose how you hear from Firmlon.</h2><p class="customer-lede">Notification preferences will be read and saved only through an authenticated settings service.</p></div><span class="customer-status-badge"><span></span>@(Model.TestModeEnabled ? "Temporary test mode" : "Preferences unavailable")</span></section>
<nav class="stage7-tabs" aria-label="Settings sections"><a class="stage7-tab" asp-page="/Customer/Settings/Profile">Profile</a><a class="stage7-tab" asp-page="/Customer/Settings/Security">Security</a><a class="stage7-tab is-active" aria-current="page" asp-page="/Customer/Settings/Notifications">Notifications</a></nav>
<section class="stage7-panel"><div class="stage7-panel-head"><div><h3>Notification preferences</h3><p>Safety-related alerts must remain governed by product policy.</p></div></div><div class="stage7-panel-body">@if (Model.TestStatus is not null) { <div class="stage7-test-confirmation" role="status">@Model.TestStatus</div> }<form method="post" aria-describedby="preference-status"><div class="stage7-setting"><div><strong>Device and safety alerts</strong><p id="device-alerts-status">Critical device notifications cannot be disabled here without explicit policy support. Preferences are unavailable.</p></div><label class="stage7-switch"><input asp-for="Input.DeviceAlerts" disabled aria-describedby="device-alerts-status" /><span class="stage7-slider" aria-hidden="true"></span><span class="sr-only">Device and safety alerts</span></label></div><div class="stage7-setting"><div><strong>Subscription and billing updates</strong><p id="billing-alerts-status">Receive approved account and payment events when available. @(Model.TestModeEnabled ? "This test value is discarded." : "Preferences are unavailable.")</p></div><label class="stage7-switch"><input asp-for="Input.BillingUpdates" disabled="@(!Model.TestModeEnabled)" aria-describedby="billing-alerts-status" /><span class="stage7-slider" aria-hidden="true"></span><span class="sr-only">Subscription and billing updates</span></label></div><div class="stage7-setting"><div><strong>Support-ticket responses</strong><p id="support-alerts-status">Receive approved support events when available. @(Model.TestModeEnabled ? "This test value is discarded." : "Preferences are unavailable.")</p></div><label class="stage7-switch"><input asp-for="Input.SupportUpdates" disabled="@(!Model.TestModeEnabled)" aria-describedby="support-alerts-status" /><span class="stage7-slider" aria-hidden="true"></span><span class="sr-only">Support-ticket responses</span></label></div><p id="preference-status" class="stage7-note">@(Model.TestModeEnabled ? "Test mode validates controls only. No preference is saved or sent." : "Email, SMS, WhatsApp, push, and delivery capabilities are not assumed. Nothing is saved or changed in preview mode.")</p><div class="stage7-form-actions"><button type="submit" class="customer-button customer-button-primary stage7-disabled" disabled="@(!Model.TestModeEnabled)" aria-describedby="preference-status">@(Model.TestModeEnabled ? "Validate test settings" : "Save preferences")</button><a class="customer-button customer-button-secondary" asp-page="/Customer/Notifications">View notifications</a></div></form></div></section>
