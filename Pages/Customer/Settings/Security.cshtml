@page
@model HydroSentinel.Pages.Customer.Settings.SecurityModel
@{ Layout = "_CustomerLayout"; ViewData["Title"] = "Security"; }
@section Styles { <link rel="stylesheet" href="~/css/customer-account-support.css" asp-append-version="true" /> }
<section class="stage7-intro"><div><p class="customer-eyebrow">Account security</p><h2>Protect your account.</h2><p class="customer-lede">Password and session controls will become available through the approved identity provider.</p></div><span class="customer-status-badge"><span></span>@(Model.TestModeEnabled ? "Temporary test mode" : "Identity unavailable")</span></section>
<nav class="stage7-tabs" aria-label="Settings sections"><a class="stage7-tab" asp-page="/Customer/Settings/Profile">Profile</a><a class="stage7-tab is-active" aria-current="page" asp-page="/Customer/Settings/Security">Security</a><a class="stage7-tab" asp-page="/Customer/Settings/Notifications">Notifications</a></nav>
<div class="stage7-grid"><section class="stage7-panel"><div class="stage7-panel-head"><div><h3>Change password</h3><p>Passwords are never displayed, stored, or logged by this page.</p></div></div><div class="stage7-panel-body">@if (Model.TestStatus is not null) { <div class="stage7-test-confirmation" role="status">@Model.TestStatus</div> }<form method="post" class="stage7-form" aria-describedby="security-status"><div asp-validation-summary="ModelOnly" class="stage7-validation"></div><div class="stage7-field"><label asp-for="Input.CurrentPassword"></label><input asp-for="Input.CurrentPassword" type="password" autocomplete="current-password" disabled="@(!Model.TestModeEnabled)" aria-describedby="security-status" /></div><div class="stage7-field"><label asp-for="Input.NewPassword"></label><input asp-for="Input.NewPassword" type="password" autocomplete="new-password" disabled="@(!Model.TestModeEnabled)" aria-describedby="security-status" /></div><div class="stage7-field"><label asp-for="Input.ConfirmPassword"></label><input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" disabled="@(!Model.TestModeEnabled)" aria-describedby="security-status" /></div><p id="security-status" class="stage7-note">@(Model.TestModeEnabled ? "Test mode checks password rules only. Values are discarded and no identity service is called." : "Password changes require current-password verification, antiforgery protection, rate limiting, and a confirmed identity-provider response. No change is attempted here.")</p><div class="stage7-form-actions"><button type="submit" class="customer-button customer-button-primary stage7-disabled" disabled="@(!Model.TestModeEnabled)" aria-describedby="security-status">@(Model.TestModeEnabled ? "Validate test submission" : "Update password")</button><a class="customer-button customer-button-secondary" asp-page="/Account/ForgotPassword">Password reset guidance</a></div></form></div></section><aside class="stage7-panel"><div class="stage7-panel-head"><div><h3>Security controls</h3><p>Only supported controls should be enabled.</p></div></div><div class="stage7-panel-body"><div class="stage7-callout"><strong>Sessions and multi-factor authentication</strong><p>Session management and MFA are not enabled in the current application. No fake controls are presented.</p></div></div></aside></div>
