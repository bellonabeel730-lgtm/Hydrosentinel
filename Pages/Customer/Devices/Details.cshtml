@page
@model HydroSentinel.Pages.Customer.Devices.DetailsModel
@{ Layout = "_CustomerLayout"; ViewData["Title"] = "Device Details"; var device = Model.Device; }

@section Styles {
    <link rel="stylesheet" href="~/css/customer-devices.css" asp-append-version="true" />
}

<div class="device-page">
    <section class="device-page-heading device-detail-heading" aria-labelledby="details-title">
        <div><p class="customer-eyebrow">Device workspace</p><h2 id="details-title">Device Details</h2><p class="customer-lede">Overview, monitoring, history and supported settings will appear after an authorized device response.</p></div>
        <div class="customer-action-row"><a class="customer-button customer-button-secondary" asp-page="/Customer/Devices/Index">Back to My Devices</a><span class="device-unavailable-badge"><span></span>Connection unavailable</span></div>
    </section>
    <section class="device-identity-panel" aria-labelledby="identity-title">
        <div class="device-identity-visual"><img src="~/images/Smart Water System Installation.png" alt="HydroSentinel controller installation context" loading="lazy" /></div>
        <div class="device-identity-copy"><p class="customer-eyebrow">DEMO DEVICE · Selected device</p><h3 id="identity-title">@(device?.Name ?? "Device record unavailable")</h3><p>@(device is null ? "Choose a demo device from My Devices." : "This is fictional device data generated for Development Demo Mode.")</p><div class="device-identity-meta"><span><strong>Model</strong><em>@(device?.Model ?? "Unavailable")</em></span><span><strong>Identifier</strong><em>@(device?.Serial ?? "Unavailable")</em></span><span><strong>Location</strong><em>@(device?.Location ?? "Unavailable")</em></span><span><strong>Last seen</strong><em>@(device?.LastSeen.LocalDateTime.ToString("g") ?? "Unavailable")</em></span></div></div>
    </section>
    <nav class="device-tabs" aria-label="Device detail sections"><a class="is-active" href="#device-overview" aria-current="page">Overview</a><a asp-page="/Customer/Monitoring/Index">Monitoring</a><a href="#device-history">History</a><a href="#device-settings">Settings</a></nav>
    <section id="device-overview" class="device-detail-grid" aria-labelledby="overview-title">
        <article class="device-detail-panel"><div class="device-section-heading"><div><p class="customer-eyebrow">Overview · illustrative</p><h3 id="overview-title">System information</h3></div></div><div class="device-data-list"><div><span>Water level</span><strong>@(device?.WaterLevel)%</strong></div><div><span>Water pressure</span><strong>@(device?.Pressure.ToString("0.0")) bar</strong></div><div><span>Pump status</span><strong>@(device?.PumpStatus)</strong></div><div><span>Signal strength</span><strong>@(device?.Signal)</strong></div><div><span>Battery</span><strong>@(device?.Battery)</strong></div><div><span>Data freshness</span><strong>Demo generated</strong></div></div><p class="device-state-callout">DEMONSTRATION ONLY — no live telemetry or hardware command is available.</p></article>
        <article class="device-detail-panel"><div class="device-section-heading"><div><p class="customer-eyebrow">Attention</p><h3>Related alerts</h3></div><a class="dashboard-text-link" asp-page="/Customer/Alerts/Index">View alerts <span aria-hidden="true">&rarr;</span></a></div><div class="device-inline-empty"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 8v4M12 16h.01" /><circle cx="12" cy="12" r="9" /></svg><div><strong>Alert data unavailable</strong><p>We cannot determine whether this device has alerts until alert services are connected.</p></div></div></article>
    </section>
    <section id="device-history" class="device-detail-panel device-tab-state"><p class="customer-eyebrow">History</p><h3>Historical readings are not connected</h3><p>Historical water-level, pressure and pump events will appear here only when a real device service returns timestamped readings.</p><a class="customer-button customer-button-secondary" asp-page="/Customer/Monitoring/Index">Open Monitoring</a></section>
    <section id="device-settings" class="device-detail-panel device-tab-state"><p class="customer-eyebrow">Settings</p><h3>Device settings are unavailable</h3><p>No remote control or device-setting operation is enabled. This page does not expose pump start/stop controls.</p><a class="customer-button customer-button-secondary" asp-page="/Customer/Help">Read Help Centre</a></section>
    <details class="device-state-reference"><summary><span><span class="customer-eyebrow">Integration-ready states</span><strong>View detail response patterns</strong></span><small>Implementation guidance · collapsed by default</small></summary><div class="device-state-disclosure"><p class="device-state-disclosure-note">These examples are reserved for a future service response and are not simultaneous customer results.</p><div class="device-state-grid"><article><span class="device-state-label is-offline">Offline</span><strong>Device is offline</strong><p>Show the last verified timestamp and support guidance.</p></article><article><span class="device-state-label is-stale">Stale</span><strong>Data may be stale</strong><p>Show freshness metadata before displaying readings.</p></article><article><span class="device-state-label is-denied">Access denied</span><strong>Access is restricted</strong><p>Do not reveal device details without authorization.</p></article><article><span class="device-state-label is-error">Request error</span><strong>Could not load details</strong><p>Offer a retry only after a real request failure.</p></article></div></div></details>
</div>
