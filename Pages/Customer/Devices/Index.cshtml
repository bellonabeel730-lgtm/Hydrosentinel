@page
@model HydroSentinel.Pages.Customer.Devices.IndexModel
@{ Layout = "_CustomerLayout"; ViewData["Title"] = "My Devices"; }
@section Styles { <link rel="stylesheet" href="~/css/customer-devices.css" asp-append-version="true" /> }
<div class="device-page">
 <section class="device-page-heading"><div><p class="customer-eyebrow">DEMO INVENTORY</p><h2>My Devices</h2><p class="customer-lede">Search and manage fictional controllers. No hardware ownership or connectivity is verified.</p></div><a class="customer-button customer-button-primary" asp-page="/Customer/Devices/Add">Add demo device</a></section>
 @if (Model.Message is not null) { <div class="stage7-test-confirmation" role="status">@Model.Message</div> }
 <form method="get" class="device-toolbar"><div><label for="device-search">Search devices</label><input id="device-search" name="Search" value="@Model.Search" placeholder="Name or serial" /></div><div><label for="device-status">Status</label><select id="device-status" name="Status"><option value="All">All statuses</option><option selected="@(Model.Status == "Online")">Online</option><option selected="@(Model.Status == "Offline")">Offline</option></select></div><button class="customer-button customer-button-secondary" type="submit">Filter</button></form>
 <section class="device-table-panel"><div class="device-section-heading"><div><p class="customer-eyebrow">Temporary demo records</p><h3>Registered controllers</h3></div><span class="device-count">@Model.Devices.Count() devices</span></div><div class="device-table-wrap"><table><thead><tr><th>Device</th><th>Model</th><th>Serial</th><th>Location</th><th>Status</th><th>Last seen</th><th>Actions</th></tr></thead><tbody>@foreach (var device in Model.Devices) { <tr><td><strong>@device.Name</strong></td><td>@device.Model</td><td>@device.Serial</td><td>@device.Location</td><td><span class="device-unavailable-badge">@device.Status</span></td><td>@device.LastSeen.LocalDateTime.ToString("g")</td><td><a class="customer-text-link" asp-page="/Customer/Devices/Details" asp-route-id="@device.Id">View</a> <form method="post" asp-page-handler="Remove" style="display:inline"><input type="hidden" name="id" value="@device.Id" /><button class="device-state-action" type="submit">Remove</button></form></td></tr> }</tbody></table></div></section>
 <aside class="device-help-band"><div><p class="customer-eyebrow">DEMONSTRATION ONLY</p><h3>These records live in temporary server memory.</h3><p>Reset Demo Data restores the original fictional account.</p></div><a class="customer-button customer-button-secondary" asp-page="/Demo">Demo controls</a></aside>
</div>
