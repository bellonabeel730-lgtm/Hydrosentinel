@page
@model HydroSentinel.Pages.Customer.Devices.AddModel
@{ Layout = "_CustomerLayout"; ViewData["Title"] = "Add Device"; }
@section Styles { <link rel="stylesheet" href="~/css/customer-devices.css" asp-append-version="true" /> }
<div class="device-page"><section class="device-page-heading"><div><p class="customer-eyebrow">DEMO REGISTRATION</p><h2>Add a demo device</h2><p class="customer-lede">This demonstrates registration UX only. It does not scan QR codes, prove ownership, or contact a controller.</p></div><a class="customer-button customer-button-secondary" asp-page="/Customer/Devices">Back to My Devices</a></section><section class="device-form-panel"><div class="device-section-heading"><div><p class="customer-eyebrow">Temporary record</p><h3>Device details</h3></div></div>@if (Model.Message is not null) { <div class="stage7-test-confirmation" role="status">@Model.Message</div> }<form method="post" class="stage7-form"><div asp-validation-summary="ModelOnly" class="stage7-validation" role="alert"></div><div class="stage7-form-grid"><div class="stage7-field"><label asp-for="Input.Name"></label><input asp-for="Input.Name" placeholder="Garden tank controller" /><span asp-validation-for="Input.Name" class="stage7-validation"></span></div><div class="stage7-field"><label asp-for="Input.Serial"></label><input asp-for="Input.Serial" placeholder="HS-009999" /><span asp-validation-for="Input.Serial" class="stage7-validation"></span></div><div class="stage7-field stage7-field-full"><label asp-for="Input.Location"></label><input asp-for="Input.Location" placeholder="Demo installation" /><span asp-validation-for="Input.Location" class="stage7-validation"></span></div></div><p class="stage7-note">DEMONSTRATION ONLY — no device registration API or hardware communication is called.</p><button class="customer-button customer-button-primary" type="submit">Add temporary demo device</button></form></section></div>
