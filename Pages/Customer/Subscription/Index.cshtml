@page
@model HydroSentinel.Pages.Customer.Subscription.IndexModel
@using HydroSentinel.Services
@inject PlanCatalog Catalog
@{ Layout = "_CustomerLayout"; ViewData["Title"] = "Subscription"; var s = Model.Data.Subscription; }
@section Styles { <link rel="stylesheet" href="~/css/customer-subscriptions-payments.css" asp-append-version="true" /> }
<section class="billing-page"><div class="billing-intro"><div><p class="customer-eyebrow">DEMO BILLING</p><h2>Your subscription</h2><p class="customer-lede">This fictional subscription is available for exploring the portal flow.</p></div><span class="billing-state billing-state-success"><i></i>Demo active</span></div><div class="billing-grid billing-grid-overview"><article class="billing-panel billing-plan-panel"><div class="billing-panel-heading"><div><p class="billing-kicker">Current plan · demonstration</p><h3>@s.PlanName plan</h3></div><span class="billing-icon billing-icon-green">₦</span></div><p class="billing-muted">Status: @s.Status · @s.BillingInterval · covered devices: @s.CoveredDevices</p><dl class="billing-detail-list"><div><dt>Started</dt><dd>@s.Started.LocalDateTime.ToString("d")</dd></div><div><dt>Next billing</dt><dd>@s.NextBilling.LocalDateTime.ToString("d")</dd></div><div><dt>Data label</dt><dd>DEMO ONLY</dd></div></dl><div class="billing-actions"><a class="customer-button customer-button-secondary" asp-page="/Customer/Subscription/Plans">Compare plans</a><a class="customer-button customer-button-primary" asp-page="/Customer/Payments/History">Payment history</a></div></article><aside class="billing-panel billing-next-panel"><p class="billing-kicker">Temporary demo state</p><h3>No real renewal is scheduled.</h3><p class="billing-muted">The page uses approved flyer figures for demonstration and never contacts Paystack.</p></aside></div><div class="billing-link-row"><a asp-page="/Customer/Payments/History">Payment history &rarr;</a><a asp-page="/Customer/Support">Ask about billing &rarr;</a></div></section>
