@page
@model HydroSentinel.Pages.Customer.Support.CreateModel
@{ Layout = "_CustomerLayout"; ViewData["Title"] = "Create Support Ticket"; }
@section Styles { <link rel="stylesheet" href="~/css/customer-account-support.css" asp-append-version="true" /> }
<section class="stage7-intro"><div><p class="customer-eyebrow">Support centre</p><h2>Tell us how we can help.</h2><p class="customer-lede">Describe the issue clearly. The form is ready for the approved support service; Development test mode can validate the interface without creating a ticket.</p></div><span class="customer-status-badge"><span></span>@(Model.TestModeEnabled ? "Temporary test mode" : "Submission unavailable")</span></section>
<div class="stage7-grid"><section class="stage7-panel"><div class="stage7-panel-head"><div><h3>New support request</h3><p>Required fields are marked in the form.</p></div></div><div class="stage7-panel-body">@if (Model.TestStatus is not null) { <div class="stage7-test-confirmation" role="status">@Model.TestStatus</div> }<form method="post" class="stage7-form" aria-describedby="support-form-status"><div asp-validation-summary="ModelOnly" class="stage7-validation" role="alert"></div><div class="stage7-form-grid"><div class="stage7-field"><label asp-for="Input.Subject"></label><input asp-for="Input.Subject" disabled="@(!Model.TestModeEnabled)" aria-describedby="support-form-status" /><span asp-validation-for="Input.Subject" class="stage7-validation"></span></div><div class="stage7-field"><label asp-for="Input.Category"></label><select asp-for="Input.Category" disabled="@(!Model.TestModeEnabled)" aria-describedby="support-form-status"><option value="">Select a category</option><option>Account access</option><option>Device support</option><option>Monitoring</option><option>Billing</option><option>Other</option></select><span asp-validation-for="Input.Category" class="stage7-validation"></span></div><div class="stage7-field stage7-field-full"><label asp-for="Input.DeviceId">Related device <span class="stage7-help">(optional)</span></label><input asp-for="Input.DeviceId" disabled="@(!Model.TestModeEnabled)" aria-describedby="support-form-status" /><span asp-validation-for="Input.DeviceId" class="stage7-validation"></span></div><div class="stage7-field stage7-field-full"><label asp-for="Input.Description"></label><textarea asp-for="Input.Description" disabled="@(!Model.TestModeEnabled)" aria-describedby="support-form-status"></textarea><span asp-validation-for="Input.Description" class="stage7-validation"></span></div></div><p id="support-form-status" class="stage7-note">@(Model.TestModeEnabled ? "Validation test mode is active. Submitted values are discarded and no support service is called." : "Ticket creation is unavailable until authenticated support persistence, ownership checks, and confirmation responses are implemented.") File uploads are intentionally not included.</p><div class="stage7-form-actions"><button class="customer-button customer-button-primary stage7-disabled" type="submit" disabled="@(!Model.TestModeEnabled)" aria-describedby="support-form-status">@(Model.TestModeEnabled ? "Validate test submission" : "Submit request")</button><a class="customer-button customer-button-secondary" asp-page="/Customer/Support">Back to Support</a></div></form></div></section><aside class="stage7-panel"><div class="stage7-panel-head"><div><h3>Before you submit</h3><p>Helpful context for the support team.</p></div></div><div class="stage7-panel-body"><ul class="stage7-checklist"><li><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></svg>Include what you expected to happen and what you observed.</li><li><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></svg>Use a related device identifier only when it is supplied by your account data.</li><li><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></svg>Never include passwords, payment secrets, or private keys.</li></ul></div></aside></div>
