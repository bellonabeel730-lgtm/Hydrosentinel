@page
@model HydroSentinel.Pages.Customer.Support.IndexModel
@{ Layout = "_CustomerLayout"; ViewData["Title"] = "Support"; }
@section Styles { <link rel="stylesheet" href="~/css/customer-account-support.css" asp-append-version="true" /> }
<section class="stage7-intro"><div><p class="customer-eyebrow">DEMO SUPPORT CENTRE</p><h2>Help when your water system needs it.</h2><p class="customer-lede">Create and review fictional tickets without sending email or contacting Firmlon.</p></div><span class="customer-status-badge"><span></span>Demonstration only</span></section><div class="stage7-grid"><section class="stage7-panel"><div class="stage7-panel-head"><div><h3>Your demo requests</h3><p>Temporary records stored in Development memory.</p></div><a class="customer-button customer-button-primary" asp-page="/Customer/Support/Create">Create demo request</a></div><div class="stage7-panel-body stage7-stack">@foreach (var ticket in Model.Data.Tickets) { <a class="stage7-link-row" asp-page="/Customer/Support/Details" asp-route-id="@ticket.Reference"><span><strong>@ticket.Subject</strong><small>@ticket.Reference · @ticket.Status · @ticket.Created.LocalDateTime.ToString("d")</small></span><em>View</em></a> }</div></section><aside class="stage7-panel"><div class="stage7-panel-head"><h3>Need an answer now?</h3></div><div class="stage7-panel-body stage7-stack"><a class="stage7-link-row" asp-page="/Customer/Help">Open Help Centre</a><a class="stage7-link-row" asp-page="/Contact">Contact Firmlon</a></div></aside></div>
