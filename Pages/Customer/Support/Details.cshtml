@page
@model HydroSentinel.Pages.Customer.Support.DetailsModel
@{ Layout = "_CustomerLayout"; ViewData["Title"] = "Support Ticket"; }
@section Styles { <link rel="stylesheet" href="~/css/customer-account-support.css" asp-append-version="true" /> }
<section class="stage7-intro"><div><p class="customer-eyebrow">DEMO TICKET · @Model.Id</p><h2>@(Model.Ticket?.Subject ?? "Demo ticket not found")</h2><p class="customer-lede">Fictional support content only. No staff member was contacted.</p></div><span class="customer-status-badge"><span></span>@(Model.Ticket?.Status ?? "Unavailable")</span></section>@if (Model.Ticket is not null) { <div class="stage7-grid"><section class="stage7-panel"><div class="stage7-panel-body"><p><strong>@Model.Ticket.Description</strong></p><p>Category: @Model.Ticket.Category · Priority: @Model.Ticket.Priority · Device: @Model.Ticket.DeviceId</p><hr />@foreach (var reply in Model.Ticket.Replies) { <div class="stage7-callout"><strong>@reply.Author · demonstration response</strong><p>@reply.Message</p></div> }</div></section><aside class="stage7-panel"><div class="stage7-panel-head"><h3>Temporary record</h3></div><div class="stage7-panel-body"><p>Created @Model.Ticket.Created.LocalDateTime.ToString("g")</p><a class="customer-button customer-button-secondary" asp-page="/Customer/Support">Back to support</a></div></aside></div> } else { <section class="stage7-panel"><div class="stage7-panel-body"><p>Reset Demo Data to restore the sample ticket.</p><a class="customer-button customer-button-secondary" asp-page="/Customer/Support">Back to support</a></div></section> }
