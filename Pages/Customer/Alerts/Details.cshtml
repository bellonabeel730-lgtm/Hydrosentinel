@page
@model HydroSentinel.Pages.Customer.Alerts.DetailsModel
@{ Layout = "_CustomerLayout"; ViewData["Title"] = "Alert Details"; }
@section Styles { <link rel="stylesheet" href="~/css/customer-monitoring-alerts.css" asp-append-version="true" /> }
<div class="alert-details-page"><div class="alert-details-back"><a class="dashboard-text-link" asp-page="/Customer/Alerts">&larr; Back to Alerts</a></div><section class="alert-details-intro"><div><p class="customer-eyebrow">DEMO ALERT · Demonstration only</p><h2>Review the sample incident.</h2><p class="customer-lede">This record is fictional and stored only in temporary Development memory.</p></div><span class="customer-status-badge"><span></span>@(Model.Alert?.Status ?? "Not found")</span></section>@if (Model.Alert is null) { <section class="alert-detail-state customer-panel"><h3>Demo alert not found</h3><p>Reset Demo Data to restore the original sample alerts.</p></section> } else { <section class="alert-detail-state customer-panel"><div><p class="customer-eyebrow">@Model.Alert.Severity · @Model.Alert.Occurred.LocalDateTime.ToString("g")</p><h3>@Model.Alert.Title</h3><p>@Model.Alert.Description</p><p>Related demo device: <strong>@Model.Alert.DeviceId</strong></p></div></section> }<section class="alert-details-actions"><a class="customer-button customer-button-secondary" asp-page="/Customer/Monitoring">Open Monitoring</a><a class="customer-button customer-button-primary" asp-page="/Customer/Alerts">Back to alerts</a></section></div>
