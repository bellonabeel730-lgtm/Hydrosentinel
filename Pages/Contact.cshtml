@page
@model HydroSentinel.Pages.ContactModel
@{ ViewData["Title"] = "Contact Firmlon"; }

<div class="page-redesign rd-contact contact-page">
    <section class="rd-section rd-section-soft" aria-labelledby="contact-title"><div class="shell rd-contact-grid"><div><p class="rd-kicker">Get in touch</p><h1 id="contact-title">Contact us.</h1><p class="rd-hero-lede">We're here to help. Reach out to our team for enquiries, support, or partnership opportunities.</p><div class="rd-contact-media"><img src="~/images/technical-support.jfif" alt="Industrial water-treatment support scene with a technician reviewing equipment" width="1412" height="768" loading="eager" fetchpriority="high"/><p class="rd-note">Supporting industrial imagery only; this is not a Firmlon office or named support team.</p></div></div><div class="rd-contact-form" id="enquiry-form"><p class="rd-kicker">Start an enquiry</p><h2>Tell us what you’re working on.</h2><p>Use the form to outline your needs. Verified office and direct contact details are not published in the current project.</p>@if (Model.StatusMessage is not null){<div class="rd-status" role="status"><strong>Review notice</strong><br/>@Model.StatusMessage</div>}<form method="post" novalidate>@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="rd-form-error" role="alert"></div><div class="rd-form-grid"><div class="rd-field"><label asp-for="Form.FullName">Full name <span aria-hidden="true">*</span></label><input asp-for="Form.FullName" autocomplete="name" placeholder="Your name"/><span asp-validation-for="Form.FullName" class="rd-form-error"></span></div><div class="rd-field"><label asp-for="Form.Email">Email address <span aria-hidden="true">*</span></label><input asp-for="Form.Email" autocomplete="email" placeholder="you@example.com"/><span asp-validation-for="Form.Email" class="rd-form-error"></span></div><div class="rd-field"><label asp-for="Form.EnquiryType">Enquiry type <span aria-hidden="true">*</span></label><select asp-for="Form.EnquiryType"><option value="">Choose an enquiry type</option><option value="Product enquiry">Product enquiry</option><option value="Pricing question">Pricing question</option><option value="Partnership discussion">Partnership discussion</option><option value="Other">Other</option></select><span asp-validation-for="Form.EnquiryType" class="rd-form-error"></span></div><div class="rd-field"><label asp-for="Form.Subject">Subject <span aria-hidden="true">*</span></label><input asp-for="Form.Subject" placeholder="How can we help?"/><span asp-validation-for="Form.Subject" class="rd-form-error"></span></div><div class="rd-field rd-field-wide"><label asp-for="Form.Message">Message <span aria-hidden="true">*</span></label><textarea asp-for="Form.Message" rows="6" placeholder="Tell us a little about your enquiry..."></textarea><span asp-validation-for="Form.Message" class="rd-form-error"></span></div></div><button class="button button-primary" type="submit">Submit message <span aria-hidden="true">→</span></button><p class="rd-form-note">Submitting currently validates your enquiry on this page only. Backend delivery still needs to be configured; this form does not claim to send a message.</p></form></div></div></section>
    <section class="rd-section"><div class="shell rd-editorial"><div><p class="rd-kicker">Additional enquiries</p><h2>Choose the conversation that fits.</h2></div><div class="rd-rule-list"><div class="rd-rule"><strong>01</strong><div><h3>Product enquiries</h3><p>Ask about HydroSentinel and its intended role in a water system.</p></div></div><div class="rd-rule"><strong>02</strong><div><h3>Pricing questions</h3><p>Request clarification where plan values or terms still require approval.</p></div></div><div class="rd-rule"><strong>03</strong><div><h3>Partnership discussions</h3><p>Share context for a potential collaboration with Firmlon.</p></div></div></div></div></section>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
