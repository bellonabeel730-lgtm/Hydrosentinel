@page
@model HydroSentinel.Pages.Admin.AdminPageModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Reports"; }
<div class="admin-page-head"><div><p class="admin-page-kicker">Decision support</p><h1>Reports</h1><p>Prepare the reporting surface while keeping export and production claims honest.</p></div><span class="admin-title-pill">Preview</span></div>
@if (!Model.IsDemo) { <div class="admin-state"><strong>Reports require source integrations</strong><p>There is no production reporting dataset in this build. Connect approved sources before enabling exports.</p></div> } else { <div class="admin-demo-note">DEVELOPMENT DEMO · These summary values are calculated from the existing fictional sample store. Export is unavailable.</div><div class="admin-grid admin-grid-3"><article class="admin-card admin-metric"><span class="admin-metric-label">Demo device records</span><strong class="admin-metric-value">@Model.Data.DeviceCount</strong><span class="admin-metric-trend">Temporary snapshot</span></article><article class="admin-card admin-metric"><span class="admin-metric-label">Demo readings</span><strong class="admin-metric-value">@Model.Data.Data.Readings.Count</strong><span class="admin-metric-trend">Generated locally</span></article><article class="admin-card admin-metric"><span class="admin-metric-label">Demo payments</span><strong class="admin-metric-value">@Model.Data.Data.Payments.Count</strong><span class="admin-metric-trend">No provider contacted</span></article></div><article class="admin-card" style="margin-top:18px"><div class="admin-card-heading"><div><h2>Report templates</h2><small>Backend-ready placeholders</small></div><button class="admin-button admin-button-secondary" type="button" disabled>Export unavailable</button></div><div class="admin-detail-list"><div><span>Device health summary</span><b>Source integration required</b></div><div><span>Revenue reconciliation</span><b>Verified ledger required</b></div><div><span>Support SLA review</span><b>Ticket service required</b></div></div></article> }
