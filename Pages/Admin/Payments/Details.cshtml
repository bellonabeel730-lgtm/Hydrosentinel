@page
@model HydroSentinel.Pages.Admin.AdminPageModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Payment detail"; var payment = Model.Data.Data.Payments.FirstOrDefault(x => x.Reference.Equals(Model.Id ?? "", StringComparison.OrdinalIgnoreCase)); }
<div class="admin-page-head"><div><p class="admin-page-kicker">Financial operations / detail</p><h1>Payment detail</h1><p>Read-only ledger preview for <code>@(Model.Id ?? "no id supplied")</code>.</p></div><a class="admin-button admin-button-secondary" asp-page="/Admin/Payments">Back to payments</a></div>
@if (!Model.IsDemo || payment is null) { <div class="admin-state"><strong>@(Model.IsDemo ? "Payment record not found" : "Payment detail unavailable")</strong><p>@(Model.IsDemo ? "The requested reference does not match a demo payment." : "Verified provider records and webhook state are required here.")</p></div> } else { <div class="admin-demo-note">DEVELOPMENT DEMO · This payment is fictional. No refunds, provider calls, or settlement actions are available.</div><article class="admin-card"><div class="admin-card-heading"><div><h2>@payment.Reference</h2><small>@payment.Date.LocalDateTime.ToString("g")</small></div><span class="admin-status active">@payment.Status</span></div><div class="admin-detail-list"><div><span>Plan</span><b>@payment.Plan</b></div><div><span>Amount</span><b>₦@payment.Amount.ToString("N0")</b></div><div><span>Currency</span><b>@payment.Currency</b></div><div><span>Record label</span><b>@payment.Label</b></div></div></article> }
