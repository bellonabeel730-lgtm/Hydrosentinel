@page
@model HydroSentinel.Pages.Admin.AdminPageModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Alert detail"; var alert = Model.Data.Data.Alerts.FirstOrDefault(x => x.Id.Equals(Model.Id ?? "", StringComparison.OrdinalIgnoreCase)); }
<div class="admin-page-head"><div><p class="admin-page-kicker">Incident review / detail</p><h1>Alert detail</h1><p>Audit-ready preview for <code>@(Model.Id ?? "no id supplied")</code>.</p></div><a class="admin-button admin-button-secondary" asp-page="/Admin/Alerts">Back to alerts</a></div>
@if (!Model.IsDemo || alert is null) { <div class="admin-state"><strong>@(Model.IsDemo ? "Alert record not found" : "Alert detail unavailable")</strong><p>@(Model.IsDemo ? "The requested identifier does not match a demo alert." : "Authenticated alert records and audit history are required here.")</p></div> } else { <div class="admin-demo-note">DEVELOPMENT DEMO · This incident is fictional and cannot be acknowledged or escalated from the preview.</div><article class="admin-card"><div class="admin-card-heading"><div><h2>@alert.Title</h2><small>@alert.Id · @alert.Occurred.LocalDateTime.ToString("g")</small></div><span class="admin-status @(alert.Severity.Equals("Warning") ? "warning" : "")">@alert.Severity</span></div><div class="admin-detail-list"><div><span>Device</span><b>@alert.DeviceId</b></div><div><span>Status</span><b>@alert.Status</b></div><div><span>Description</span><b>@alert.Description</b></div></div><div class="admin-state" style="margin-top:20px"><strong>Workflow unavailable</strong><p>Assigning, acknowledging, and resolving alerts require an authenticated role and audit log.</p><button class="admin-button admin-button-secondary" type="button" disabled>Acknowledge unavailable</button></div></article> }
