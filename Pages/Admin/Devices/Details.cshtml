@page
@model HydroSentinel.Pages.Admin.AdminPageModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Device detail"; var device = Model.Data.Data.Devices.FirstOrDefault(x => x.Id.Equals(Model.Id ?? "", StringComparison.OrdinalIgnoreCase)); }
<div class="admin-page-head"><div><p class="admin-page-kicker">Device registry / detail</p><h1>Device detail</h1><p>Read-only operational projection for <code>@(Model.Id ?? "no id supplied")</code>.</p></div><a class="admin-button admin-button-secondary" asp-page="/Admin/Devices">Back to devices</a></div>
@if (!Model.IsDemo || device is null) { <div class="admin-state"><strong>@(Model.IsDemo ? "Device record not found" : "Device detail unavailable")</strong><p>@(Model.IsDemo ? "The requested identifier does not match a demo device." : "Authenticated device ownership and telemetry data are required here.")</p></div> } else { <div class="admin-demo-note">DEVELOPMENT DEMO · Connectivity values are simulated. Hardware control commands are not exposed.</div><div class="admin-grid admin-grid-2"><article class="admin-card"><div class="admin-card-heading"><div><h2>@device.Name</h2><small>@device.Model · @device.Serial</small></div><span class="admin-status @(device.Status.Equals("Online") ? "online" : "offline")">@device.Status</span></div><div class="admin-detail-list"><div><span>Location</span><b>@device.Location</b></div><div><span>Last seen</span><b>@device.LastSeen.LocalDateTime.ToString("g")</b></div><div><span>Water level</span><b>@device.WaterLevel%</b></div><div><span>Pressure</span><b>@device.Pressure.ToString("0.0") bar</b></div><div><span>Pump state</span><b>@device.PumpStatus</b></div></div></article><article class="admin-card"><div class="admin-card-heading"><div><h2>Device actions</h2><small>Safety boundary</small></div></div><div class="admin-state"><strong>Monitoring only</strong><p>Reconnect, restart, calibration, and pump controls require a separately approved hardware command service.</p><button class="admin-button admin-button-secondary" type="button" disabled>Controls unavailable</button></div></article></div> }
