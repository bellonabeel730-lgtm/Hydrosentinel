@page
@model HydroSentinel.Pages.Admin.AdminPageModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Dashboard"; var d = Model.Data; }
<div class="admin-page-head"><div><p class="admin-page-kicker">Operations control room</p><h1>Good morning, admin.</h1><p>One view of the HydroSentinel network and the work that needs attention.</p></div><span class="admin-title-pill">@(Model.IsDemo ? "Development demo" : "Integration required")</span></div>
@if (Model.IsDemo) { <div class="admin-demo-note">DEVELOPMENT DEMO PROJECTION · All records below are fictional, temporary, and not connected to customers, hardware, payments, or telemetry.</div> }
@if (!Model.IsDemo) { <div class="admin-state"><strong>Admin data integration required</strong><p>Connect authenticated customer, device, billing, support, and telemetry services to populate this workspace. No production data is fabricated here.</p></div> } else { <div class="admin-grid admin-grid-4"><article class="admin-card admin-metric"><span class="admin-metric-label">Registered devices</span><strong class="admin-metric-value">@d.DeviceCount</strong><span class="admin-metric-trend">@d.OnlineDeviceCount online in demo</span></article><article class="admin-card admin-metric"><span class="admin-metric-label">Open alerts</span><strong class="admin-metric-value">@d.OpenAlertCount</strong><span class="admin-metric-trend warn">Needs review</span></article><article class="admin-card admin-metric"><span class="admin-metric-label">Support queue</span><strong class="admin-metric-value">@d.OpenTicketCount</strong><span class="admin-metric-trend">Demo tickets only</span></article><article class="admin-card admin-metric"><span class="admin-metric-label">Plans in catalog</span><strong class="admin-metric-value">@Model.Portal.Plans.Count</strong><span class="admin-metric-trend">Flyer figures only</span></article></div><div class="admin-grid admin-grid-2" style="margin-top:18px"><article class="admin-card"><div class="admin-card-heading"><div><h2>Network pulse</h2><small>Illustrative 12-point water level trend</small></div><span class="admin-status online">Demo sample</span></div><div class="admin-chart" aria-label="Illustrative demo water level chart">@foreach(var r in d.Data.Readings) { <div class="admin-bar" style="height:@(r.WaterLevel + 5)%"><span>@r.Timestamp.ToString("HH:mm")</span></div> }</div></article><article class="admin-card"><div class="admin-card-heading"><div><h2>Needs attention</h2><small>Prioritised demo records</small></div><a class="admin-link" asp-page="/Admin/Alerts">View all</a></div><div class="admin-detail-list">@foreach(var a in d.Data.Alerts) { <div><span><strong>@a.Title</strong><br />@a.Description</span><b class="admin-status @(a.Severity.Equals("Warning") ? "warning" : "")">@a.Severity</b></div> }</div></article></div> }
