@page
@model HydroSentinel.Pages.Admin.AdminPageModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Support"; }
<div class="admin-page-head"><div><p class="admin-page-kicker">Service desk</p><h1>Support queue</h1><p>Give the care team a clear queue without sending replies from the demo.</p></div><span class="admin-title-pill">@Model.Data.OpenTicketCount open</span></div>
@if (!Model.IsDemo) { <div class="admin-state"><strong>Support queue unavailable</strong><p>Connect the authenticated ticketing service to enable triage and response workflows.</p></div> } else { <div class="admin-demo-note">DEVELOPMENT DEMO · Ticket records are fictional. Reply and assignment controls remain unavailable until backend ownership and audit contracts exist.</div><div class="admin-card"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Reference</th><th>Subject</th><th>Category</th><th>Priority</th><th>Updated</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model.Data.Data.Tickets) { <tr><td><strong>@x.Reference</strong></td><td>@x.Subject</td><td>@x.Category</td><td>@x.Priority</td><td>@x.Updated.LocalDateTime.ToString("g")</td><td><span class="admin-status open">@x.Status</span></td></tr>}</tbody></table></div></div> }
