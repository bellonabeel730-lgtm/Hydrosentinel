@page
@model HydroSentinel.Pages.Admin.AdminPageModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Support detail"; var ticket = Model.Data.Data.Tickets.FirstOrDefault(x => x.Reference.Equals(Model.Id ?? "", StringComparison.OrdinalIgnoreCase)); }
<div class="admin-page-head"><div><p class="admin-page-kicker">Service desk / detail</p><h1>Support detail</h1><p>Read-only queue preview for <code>@(Model.Id ?? "no id supplied")</code>.</p></div><a class="admin-button admin-button-secondary" asp-page="/Admin/Support">Back to support</a></div>
@if (!Model.IsDemo || ticket is null) { <div class="admin-state"><strong>@(Model.IsDemo ? "Support ticket not found" : "Support detail unavailable")</strong><p>@(Model.IsDemo ? "The requested reference does not match a demo ticket." : "The authenticated ticket service is required here.")</p></div> } else { <div class="admin-demo-note">DEVELOPMENT DEMO · This conversation is fictional. Reply, assignment, and status changes are unavailable.</div><article class="admin-card"><div class="admin-card-heading"><div><h2>@ticket.Subject</h2><small>@ticket.Reference · @ticket.Category</small></div><span class="admin-status open">@ticket.Status</span></div><div class="admin-detail-list"><div><span>Priority</span><b>@ticket.Priority</b></div><div><span>Created</span><b>@ticket.Created.LocalDateTime.ToString("g")</b></div><div><span>Description</span><b>@ticket.Description</b></div></div><div class="admin-state" style="margin-top:20px"><strong>Response workflow unavailable</strong><p>Ticket replies require authenticated ownership, notification delivery, and audit logging.</p><button class="admin-button admin-button-secondary" type="button" disabled>Reply unavailable</button></div></article> }
