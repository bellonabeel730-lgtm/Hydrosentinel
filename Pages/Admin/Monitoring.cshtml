@page
@model HydroSentinel.Pages.Admin.AdminPageModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Monitoring"; }
<div class="admin-page-head"><div><p class="admin-page-kicker">Read-only telemetry view</p><h1>Monitoring</h1><p>Surface health signals for review; no commands are available from this console.</p></div><span class="admin-title-pill">Telemetry</span></div>
@if (!Model.IsDemo) { <div class="admin-state"><strong>Telemetry integration required</strong><p>Live readings are intentionally not invented. Connect a trusted telemetry service to populate this view.</p></div> } else { <div class="admin-demo-note">DEVELOPMENT DEMO · The graph and metrics below are generated from the existing sample account and are not live measurements.</div><div class="admin-grid admin-grid-3"><article class="admin-card admin-metric"><span class="admin-metric-label">Latest water level</span><strong class="admin-metric-value">@Model.Data.Data.Readings.Last().WaterLevel%</strong><span class="admin-metric-trend">Illustrative sample</span></article><article class="admin-card admin-metric"><span class="admin-metric-label">Latest pressure</span><strong class="admin-metric-value">@Model.Data.Data.Readings.Last().Pressure.ToString("0.0") <small>bar</small></strong><span class="admin-metric-trend">Illustrative sample</span></article><article class="admin-card admin-metric"><span class="admin-metric-label">Sample range</span><strong class="admin-metric-value">12</strong><span class="admin-metric-trend">points in memory</span></article></div><article class="admin-card" style="margin-top:18px"><div class="admin-card-heading"><div><h2>Water level history</h2><small>Generated demo readings · last 12 sample points</small></div></div><div class="admin-chart" aria-label="Illustrative demo water level history">@foreach(var r in Model.Data.Data.Readings) { <div class="admin-bar" style="height:@(r.WaterLevel + 5)%"><span>@r.Timestamp.ToString("HH:mm")</span></div> }</div></article> }
