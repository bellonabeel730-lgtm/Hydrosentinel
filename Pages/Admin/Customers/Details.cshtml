@page
@model HydroSentinel.Pages.Admin.AdminPageModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Customer detail"; var p = Model.Data.Data.Profile; var valid = Model.Id?.Equals("demo-customer", StringComparison.OrdinalIgnoreCase) == true; }
<div class="admin-page-head"><div><p class="admin-page-kicker">Customer directory / detail</p><h1>Customer detail</h1><p>Read-only account projection for <code>@(Model.Id ?? "no id supplied")</code>.</p></div><a class="admin-button admin-button-secondary" asp-page="/Admin/Customers">Back to customers</a></div>
@if (!Model.IsDemo || !valid) { <div class="admin-state"><strong>@(Model.IsDemo ? "Customer record not found" : "Customer detail unavailable")</strong><p>@(Model.IsDemo ? "The requested identifier does not match a demo record. No customer data has been invented." : "Authenticated customer data is required before this detail route can display production information.")</p></div> } else { <div class="admin-demo-note">DEVELOPMENT DEMO · Fictional customer record. Actions, impersonation, billing changes, and messaging are unavailable.</div><div class="admin-grid admin-grid-2"><article class="admin-card"><div class="admin-card-heading"><div><h2>@p.FullName</h2><small>@p.Company</small></div><span class="admin-status active">Demo active</span></div><div class="admin-detail-list"><div><span>Email</span><b>@p.Email</b></div><div><span>Phone</span><b>@p.Phone</b></div><div><span>Plan</span><b>Pro</b></div><div><span>Covered devices</span><b>@Model.Data.DeviceCount</b></div></div></article><article class="admin-card"><div class="admin-card-heading"><div><h2>Account actions</h2><small>Backend authorization required</small></div></div><div class="admin-state"><strong>Read-only preview</strong><p>Customer updates and support impersonation require verified admin roles and audit logging.</p><button class="admin-button admin-button-secondary" type="button" disabled>Actions unavailable</button></div></article></div> }
