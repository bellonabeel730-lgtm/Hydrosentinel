@page
@model HydroSentinel.Pages.Admin.AdminPageModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Alerts"; }
<div class="admin-page-head"><div><p class="admin-page-kicker">Incident review</p><h1>Alerts</h1><p>Review signals and route follow-up to the right team.</p></div><span class="admin-title-pill">@Model.Data.OpenAlertCount open</span></div>
@if (!Model.IsDemo) { <div class="admin-state"><strong>Alert stream unavailable</strong><p>Production alert records require the authenticated alert service and audit policy.</p></div> } else { <div class="admin-demo-note">DEVELOPMENT DEMO · These alert records are fictional. Acknowledge actions are disabled until an admin identity and audit trail exist.</div><div class="admin-card"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Alert</th><th>Device</th><th>Severity</th><th>Occurred</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach(var a in Model.Data.Data.Alerts) { <tr><td><strong>@a.Title</strong><br /><small>@a.Description</small></td><td>@a.DeviceId</td><td><span class="admin-status @(a.Severity.Equals("Warning") ? "warning" : "")">@a.Severity</span></td><td>@a.Occurred.LocalDateTime.ToString("g")</td><td>@a.Status</td><td><button class="admin-button admin-button-secondary" type="button" disabled>Acknowledge unavailable</button></td></tr>}</tbody></table></div></div> }
