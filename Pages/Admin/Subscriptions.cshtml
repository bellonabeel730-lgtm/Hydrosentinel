@page
@model HydroSentinel.Pages.Admin.AdminPageModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Subscriptions"; }
<div class="admin-page-head"><div><p class="admin-page-kicker">Commercial catalogue</p><h1>Subscriptions</h1><p>Review approved plan figures without changing customer billing.</p></div><span class="admin-title-pill">PlanCatalog</span></div>
<div class="admin-notice">Prices below are read from the existing PlanCatalog and remain flyer-supplied figures. Final commercial terms and entitlements require backend confirmation.</div><div class="admin-grid admin-grid-3" style="margin-top:18px">@foreach(var plan in Model.Portal.Plans) { <article class="admin-card"><div class="admin-card-heading"><div><h2>@plan.Name</h2><small>@plan.DeviceAllowance</small></div><span class="admin-status active">Catalog</span></div><div class="admin-plan-price">₦@plan.MonthlyPrice.ToString("N0") <small>/ month</small></div><p style="font-size:11px;color:var(--admin-muted);line-height:1.5">@plan.Description</p><div class="admin-detail-list"><div><span>Hardware</span><b>₦@plan.HardwarePrice.ToString("N0")</b></div><div><span>Admin action</span><b>Unavailable</b></div></div></article>}</div>
