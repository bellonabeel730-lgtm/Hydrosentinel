@page
@model HydroSentinel.Pages.Admin.AdminPageModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Devices"; }
<div class="admin-page-head"><div><p class="admin-page-kicker">Asset registry</p><h1>Devices</h1><p>Review registration and connectivity without issuing hardware commands.</p></div><span class="admin-title-pill">Read-only</span></div>
@if (!Model.IsDemo) { <div class="admin-state"><strong>Device registry unavailable</strong><p>Connect the device registry and authorization policy before operational records can be displayed.</p></div> } else { <div class="admin-demo-note">DEVELOPMENT DEMO · Connectivity and readings are simulated. Pump-control actions are intentionally absent.</div><div class="admin-card"><div class="admin-card-heading"><div><h2>Registered demo devices</h2><small>@Model.Data.DeviceCount total · @Model.Data.OnlineDeviceCount online</small></div><button class="admin-button admin-button-secondary" type="button" disabled>Register device unavailable</button></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Device</th><th>Model / serial</th><th>Location</th><th>Last seen</th><th>Water level</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model.Data.Data.Devices) { <tr><td><strong>@x.Name</strong></td><td>@x.Model<br /><small>@x.Serial</small></td><td>@x.Location</td><td>@x.LastSeen.LocalDateTime.ToString("g")</td><td>@x.WaterLevel%</td><td><span class="admin-status @(x.Status.Equals("Online") ? "online" : "offline")">@x.Status</span></td></tr>}</tbody></table></div></div> }
