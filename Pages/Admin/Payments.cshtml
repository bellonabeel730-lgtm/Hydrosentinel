@page
@model HydroSentinel.Pages.Admin.AdminPageModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Payments"; }
<div class="admin-page-head"><div><p class="admin-page-kicker">Financial operations</p><h1>Payments</h1><p>Payment records are kept separate from the customer checkout demo.</p></div><span class="admin-title-pill">Read-only</span></div>
@if (!Model.IsDemo) { <div class="admin-state"><strong>Payment ledger unavailable</strong><p>No payment provider is contacted by this build. Connect verified transaction and webhook services before displaying production records.</p></div> } else { <div class="admin-demo-note">DEVELOPMENT DEMO · Sample payment history only. No payment calls, card details, refunds, or settlement actions are available.</div><div class="admin-card"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Reference</th><th>Date</th><th>Plan</th><th>Amount</th><th>Status</th><th>Label</th></tr></thead><tbody>@foreach(var x in Model.Data.Data.Payments) { <tr><td><strong>@x.Reference</strong></td><td>@x.Date.LocalDateTime.ToString("g")</td><td>@x.Plan</td><td>₦@x.Amount.ToString("N0")</td><td><span class="admin-status @(x.Status == "success" ? "active" : x.Status == "failed" ? "failed" : "warning")">@x.Status</span></td><td>@x.Label</td></tr>}</tbody></table></div></div> }
