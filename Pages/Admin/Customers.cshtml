@page
@model HydroSentinel.Pages.Admin.AdminPageModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Customers"; var p = Model.Data.Data.Profile; }
<div class="admin-page-head"><div><p class="admin-page-kicker">Workspace directory</p><h1>Customers</h1><p>Customer records will come from the authenticated admin service.</p></div><span class="admin-title-pill">Directory</span></div>
@if (!Model.IsDemo) { <div class="admin-state"><strong>Customer directory unavailable</strong><p>No production customer data is available in this build. Connect the customer service to enable search, profiles, and account actions.</p></div> } else { <div class="admin-demo-note">DEVELOPMENT DEMO · One fictional customer projection is shown to exercise the directory layout.</div><div class="admin-card"><div class="admin-filterbar"><label>Search customer<input type="search" placeholder="Search is demo-local only" aria-label="Search customer" /></label><button class="admin-button admin-button-secondary" type="button" disabled>Export unavailable</button></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Customer</th><th>Company</th><th>Devices</th><th>Plan</th><th>State</th><th></th></tr></thead><tbody><tr><td><strong>@p.FullName</strong><br /><small>@p.Email</small></td><td>@p.Company</td><td>@Model.Data.DeviceCount</td><td>Pro</td><td><span class="admin-status active">Demo active</span></td><td><a class="admin-link" asp-page="/Admin/Devices">View devices</a></td></tr></tbody></table></div></div> }
